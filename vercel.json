{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "goretok.life" }],
      "destination": "/goretok",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.goretok.life" }],
      "destination": "/goretok",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin-gate" },
    { "source": "/admin.html", "destination": "/api/admin-gate" },
    { "source": "/goretok", "destination": "/goretok/index.html" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/api/goretok/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
